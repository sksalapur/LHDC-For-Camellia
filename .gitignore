# ==============================================================================
# Git Ignore Configuration for LHDC-For-Camellia
# ==============================================================================

# Bluetooth snoops, dumps, and traces
*.cfa
*.pcap
*.cap
*.log
*.txt
dump_*.txt
logcat_*.txt
bluetooth_dump*.txt
miui_bt_dump*.txt
infinityx_dump.txt
bths.txt

# Screenshots, diagrams, and UI XML dumps
*.png
*.jpg
*.jpeg
ui*.xml

# Compiled binaries, objects, and libraries
*.o
*.obj
*.elf
*.bin
*.class
*.pyc
*.dex
__pycache__/

# Scratch scripts, inspection tools, and test suites
/check_*.py
/disas_*.py
/disasm_*.py
/find_*.py
/inspect_*.py
/decode_*.py
/print_*.py
/search_*.py
/test_*
test_feed*
test_96k*
test_lhdcv5*
test_shim*
test_asm*
patch11*
patch_parse*
flag.*
vdex_test

# Intermediate helper and build scripts
/deploy_*.sh
/update_miuibt.sh
/inject_mount.sh
/setup_apex.sh
/patch_jni_v[0-7].py
/liblhdcBT_enc_shim.so
/parse_elf_symbols.py
/parse_snoop.py

# Unneeded reference and ROM trees
/derp_patches/
/evox_liblhdc/
/ExtA2DP/
/lhdc_universal/
/spr_liblhdc/
/src/
/voltage_build/
/scratch/

# Scratch databases and backups
*.db
*.db-shm
*.db-wal
*.backup
*.bak

# Unneeded raw APKs, SOs, and JARs in root
/*.apk
/*.so
/*.jar
/*.zip
!/LHDC-for-Camellia.zip
/*.jar

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
Thumbs.db
Desktop.ini
.DS_Store
